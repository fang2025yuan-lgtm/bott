# UFQ Event Bot - Muhit o'zgaruvchilari
# Bu faylni .env ga nusxalang va qiymatlarni to'ldiring

# Telegram Bot Token (@BotFather dan olinadi)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Super Admin ning Telegram ID raqami (@userinfobot dan bilib olish mumkin)
SUPER_ADMIN_ID=123456789

# Majburiy kanallar (vergul bilan ajratiladi)
# Misol: -1001234567890,@mychannel
CHANNELS=-1001234567890,@ufq_channel

# Bot username (@ belgisisiz)
# @BotFather da ko'rsatilgan username
BOT_USERNAME=ufq_events_bot

# Ma'lumotlar bazasi (o'zgartirish shart emas)
DATABASE_URL=sqlite+aiosqlite:///ufq_events.db
